---
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Рассчитать стоимость проекта", 
  subtitle = "Заполните поля ниже, и мы свяжемся с вами в течение часа с детальным коммерческим предложением." 
} = Astro.props;
---

<section class="relative py-[clamp(5rem,9vw,9rem)] bg-bg-darkest border-t border-border z-10" id="contact">
  <!-- Glow decorations -->
  <div class="absolute top-20 -right-32 w-72 h-72 bg-glow-amber rounded-full blur-3xl animate-glow-pulse pointer-events-none"></div>
  <div class="absolute bottom-20 -left-24 w-56 h-56 bg-glow-violet rounded-full blur-3xl animate-float pointer-events-none"></div>

  <div class="w-full max-w-[1200px] mx-auto px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-12 items-start">
      
      <!-- Left Info Block -->
      <div class="flex flex-col gap-4" data-reveal>
        <span class="font-mono text-[0.7rem] font-normal tracking-[0.15em] text-accent inline-flex items-center gap-2 mb-4 uppercase before:content-['//'] before:text-text-muted">СВЯЗАТЬСЯ //</span>
        <h2>Давайте создавать вместе</h2>
        <p class="text-[1.05rem] leading-[1.7] text-text-secondary max-w-[480px]">
          Мы открыты для съемок, записи подкастов и проектов любой сложности. Напишите нам, чтобы обсудить детали и составить смету.
        </p>

        <div class="flex flex-col gap-6 mt-4">
          <div class="flex flex-col gap-0.5">
            <span class="font-mono text-[0.65rem] text-text-muted uppercase tracking-[0.1em]">Адрес студии</span>
            <span class="text-lg font-medium text-text-primary">Екатеринбург, ул. Ботаническая 19</span>
          </div>
          <div class="flex flex-col gap-0.5">
            <span class="font-mono text-[0.65rem] text-text-muted uppercase tracking-[0.1em]">Телефон</span>
            <a href="tel:+79923410520" class="text-lg font-medium text-text-primary hover:text-accent transition-colors duration-200">+7 992 341-05-20</a>
          </div>
          <div class="flex flex-col gap-0.5">
            <span class="font-mono text-[0.65rem] text-text-muted uppercase tracking-[0.1em]">Email</span>
            <a href="mailto:hvaliteq@gmail.com" class="text-lg font-medium text-text-primary hover:text-accent transition-colors duration-200">hvaliteq@gmail.com</a>
          </div>
        </div>
      </div>

      <!-- Form Block -->
      <div class="relative rounded bg-glass border border-border backdrop-blur-[20px] p-8 lg:p-12 overflow-hidden shadow-[0_16px_48px_rgba(0,0,0,0.9)]" id="form-container" data-reveal data-reveal-delay="2">
        <!-- Inner glow -->
        <div class="absolute -top-20 -right-20 w-40 h-40 bg-glow-amber rounded-full blur-3xl opacity-50 pointer-events-none"></div>

        <h3 class="text-2xl mb-1 tracking-[-0.01em]">{title}</h3>
        <p class="text-sm text-text-secondary mb-8 leading-relaxed">{subtitle}</p>

        <form id="project-form" class="flex flex-col gap-6" novalidate>
          
          <!-- Category Selector Pills -->
          <div>
            <span class="block font-mono text-[0.7rem] uppercase tracking-[0.08em] text-text-secondary mb-2">Выбрать формат //</span>
            <div class="flex flex-wrap gap-2 mt-2" role="group" aria-label="Формат проекта">
              <button type="button" class="pill-btn active bg-transparent border border-border rounded-sm text-text-secondary font-body text-[0.8rem] font-medium px-4 py-1.5 cursor-pointer transition-all duration-200 hover:border-white hover:text-white [&.active]:border-white [&.active]:text-white [&.active]:bg-white/5 [&.active]:shadow-[0_0_12px_rgba(255,255,255,0.06)]" data-value="видеопроизводство">Видеопроизводство</button>
              <button type="button" class="pill-btn bg-transparent border border-border rounded-sm text-text-secondary font-body text-[0.8rem] font-medium px-4 py-1.5 cursor-pointer transition-all duration-200 hover:border-white hover:text-white [&.active]:border-white [&.active]:text-white [&.active]:bg-white/5 [&.active]:shadow-[0_0_12px_rgba(255,255,255,0.06)]" data-value="студия подкастов">Студия подкастов</button>
              <button type="button" class="pill-btn bg-transparent border border-border rounded-sm text-text-secondary font-body text-[0.8rem] font-medium px-4 py-1.5 cursor-pointer transition-all duration-200 hover:border-white hover:text-white [&.active]:border-white [&.active]:text-white [&.active]:bg-white/5 [&.active]:shadow-[0_0_12px_rgba(255,255,255,0.06)]" data-value="реклама и клипы">Реклама & Клипы</button>
              <button type="button" class="pill-btn bg-transparent border border-border rounded-sm text-text-secondary font-body text-[0.8rem] font-medium px-4 py-1.5 cursor-pointer transition-all duration-200 hover:border-white hover:text-white [&.active]:border-white [&.active]:text-white [&.active]:bg-white/5 [&.active]:shadow-[0_0_12px_rgba(255,255,255,0.06)]" data-value="монтаж и графика">Монтаж & Графика</button>
            </div>
            <input type="hidden" name="project_format" id="format-hidden-input" value="видеопроизводство" />
          </div>

          <!-- Form Fields -->
          <div class="flex flex-col gap-4">
            <div>
              <label for="name-input" class="block font-mono text-[0.7rem] uppercase tracking-[0.08em] text-text-secondary mb-2">01 // Ваше имя</label>
              <input 
                type="text" 
                id="name-input" 
                name="name" 
                class="w-full bg-bg-darkest border border-border rounded-sm px-4 py-3.5 text-text-primary font-body text-[0.95rem] font-normal transition-all duration-400 placeholder:text-text-muted focus:outline-none focus:border-white focus:bg-white/[0.01] focus:shadow-[0_0_16px_rgba(255,255,255,0.04)] [&.invalid]:border-red-500 [&.invalid]:bg-red-500/[0.02]" 
                placeholder="Иван Иванов" 
                required 
              />
              <span class="error-msg hidden text-[0.72rem] text-red-500 mt-1 font-mono" id="name-error">Пожалуйста, укажите имя</span>
            </div>

            <div>
              <label for="phone-input" class="block font-mono text-[0.7rem] uppercase tracking-[0.08em] text-text-secondary mb-2">02 // Номер телефона</label>
              <input 
                type="tel" 
                id="phone-input" 
                name="phone" 
                class="w-full bg-bg-darkest border border-border rounded-sm px-4 py-3.5 text-text-primary font-body text-[0.95rem] font-normal transition-all duration-400 placeholder:text-text-muted focus:outline-none focus:border-white focus:bg-white/[0.01] focus:shadow-[0_0_16px_rgba(255,255,255,0.04)] [&.invalid]:border-red-500 [&.invalid]:bg-red-500/[0.02]" 
                placeholder="+7 (999) 000-00-00" 
                required 
              />
              <span class="error-msg hidden text-[0.72rem] text-red-500 mt-1 font-mono" id="phone-error">Введите корректный номер телефона</span>
            </div>

            <div>
              <label for="email-input" class="block font-mono text-[0.7rem] uppercase tracking-[0.08em] text-text-secondary mb-2">03 // Электронная почта</label>
              <input 
                type="email" 
                id="email-input" 
                name="email" 
                class="w-full bg-bg-darkest border border-border rounded-sm px-4 py-3.5 text-text-primary font-body text-[0.95rem] font-normal transition-all duration-400 placeholder:text-text-muted focus:outline-none focus:border-white focus:bg-white/[0.01] focus:shadow-[0_0_16px_rgba(255,255,255,0.04)] [&.invalid]:border-red-500 [&.invalid]:bg-red-500/[0.02]" 
                placeholder="ivan@example.ru" 
                required 
              />
              <span class="error-msg hidden text-[0.72rem] text-red-500 mt-1 font-mono" id="email-error">Введите корректный адрес почты</span>
            </div>

            <div>
              <label for="message-textarea" class="block font-mono text-[0.7rem] uppercase tracking-[0.08em] text-text-secondary mb-2">04 // Описание проекта</label>
              <textarea 
                id="message-textarea" 
                name="message" 
                class="w-full bg-bg-darkest border border-border rounded-sm px-4 py-3.5 text-text-primary font-body text-[0.95rem] font-normal resize-y transition-all duration-400 placeholder:text-text-muted focus:outline-none focus:border-white focus:bg-white/[0.01] focus:shadow-[0_0_16px_rgba(255,255,255,0.04)]" 
                placeholder="Расскажите о вашей задаче, хронометраже, целях съемок..." 
                rows="3"
              ></textarea>
            </div>
          </div>

          <div class="mt-2">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" id="agreement-checkbox" name="agreement" required class="mt-1" />
              <span class="text-[0.82rem] text-text-secondary leading-snug">Я согласен с <a href="/privacy" target="_blank" class="text-white underline hover:text-accent transition-colors duration-200">политикой конфиденциальности</a></span>
            </label>
            <span class="error-msg hidden text-[0.72rem] text-red-500 mt-1 font-mono" id="agreement-error">Необходимо ваше согласие</span>
          </div>

          <button type="submit" class="self-start inline-flex items-center justify-center px-8 py-3.5 font-display text-[0.78rem] font-bold uppercase tracking-[0.1em] rounded-sm bg-white text-bg-darkest transition-all duration-400 hover:bg-primary-hover hover:-translate-y-0.5 hover:shadow-[0_0_30px_rgba(255,255,255,0.15)] cursor-pointer">
            ОТПРАВИТЬ ЗАЯВКУ //
          </button>
        </form>

        <!-- Success Screen Overlay -->
        <div class="absolute inset-0 bg-bg-card z-20 flex items-center justify-center p-8 text-center opacity-0 invisible transition-all duration-400 [&.active]:opacity-100 [&.active]:visible" id="success-overlay">
          <div class="flex flex-col items-center gap-4 max-w-[380px]">
            <div class="w-14 h-14 rounded-full bg-white/[0.03] text-white flex items-center justify-center border border-white shadow-[0_0_24px_rgba(255,255,255,0.1)]">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
            </div>
            <h4 class="text-xl font-bold">Заявка успешно отправлена!</h4>
            <p class="text-sm text-text-secondary leading-relaxed">Мы получили вашу информацию и свяжемся с вами в течение часа для детального обсуждения.</p>
            <button id="reset-form-btn" class="inline-flex items-center justify-center px-6 py-2.5 font-display text-xs font-bold uppercase tracking-[0.1em] rounded-sm border border-border text-text-primary bg-transparent transition-all duration-400 hover:border-white hover:bg-white/[0.03] cursor-pointer">Отправить еще раз</button>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('project-form') as HTMLFormElement;
  const nameInput = document.getElementById('name-input') as HTMLInputElement;
  const phoneInput = document.getElementById('phone-input') as HTMLInputElement;
  const emailInput = document.getElementById('email-input') as HTMLInputElement;
  const agreement = document.getElementById('agreement-checkbox') as HTMLInputElement;
  const successOverlay = document.getElementById('success-overlay');
  const resetBtn = document.getElementById('reset-form-btn');
  const formatInput = document.getElementById('format-hidden-input') as HTMLInputElement;
  const pillBtns = document.querySelectorAll('.pill-btn');

  // Format Pills Interaction
  pillBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      pillBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const val = btn.getAttribute('data-value');
      if (val && formatInput) {
        formatInput.value = val;
      }
    });
  });

  function validateField(input: HTMLInputElement, errorId: string): boolean {
    const errorEl = document.getElementById(errorId);
    const isValid = input.checkValidity();

    if (!isValid) {
      input.classList.add('invalid');
      errorEl?.classList.remove('hidden');
      errorEl?.classList.add('block');
    } else {
      input.classList.remove('invalid');
      errorEl?.classList.add('hidden');
      errorEl?.classList.remove('block');
    }
    return isValid;
  }

  nameInput?.addEventListener('blur', () => validateField(nameInput, 'name-error'));
  phoneInput?.addEventListener('blur', () => validateField(phoneInput, 'phone-error'));
  emailInput?.addEventListener('blur', () => validateField(emailInput, 'email-error'));
  agreement?.addEventListener('change', () => {
    const err = document.getElementById('agreement-error');
    if (agreement.checked) {
      err?.classList.add('hidden');
      err?.classList.remove('block');
    } else {
      err?.classList.remove('hidden');
      err?.classList.add('block');
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const isNameValid = validateField(nameInput, 'name-error');
    const isPhoneValid = validateField(phoneInput, 'phone-error');
    const isEmailValid = validateField(emailInput, 'email-error');
    
    const isAgreementValid = agreement.checked;
    const agreementError = document.getElementById('agreement-error');
    if (!isAgreementValid) {
      agreementError?.classList.remove('hidden');
      agreementError?.classList.add('block');
    } else {
      agreementError?.classList.add('hidden');
      agreementError?.classList.remove('block');
    }

    if (isNameValid && isPhoneValid && isEmailValid && isAgreementValid) {
      const formData = new FormData(form);
      console.log('Form submission completed:', Object.fromEntries(formData));

      if (successOverlay) {
        successOverlay.classList.add('active');
      }
    }
  });

  resetBtn?.addEventListener('click', () => {
    form?.reset();
    successOverlay?.classList.remove('active');
    
    // Clear validation styles
    document.querySelectorAll('input.invalid').forEach(el => el.classList.remove('invalid'));
    document.querySelectorAll('.error-msg').forEach(el => {
      el.classList.add('hidden');
      el.classList.remove('block');
    });
    
    // Reset format pills
    pillBtns.forEach(b => b.classList.remove('active'));
    pillBtns[0].classList.add('active');
    if (formatInput) {
      formatInput.value = 'видеопроизводство';
    }
  });
</script>
