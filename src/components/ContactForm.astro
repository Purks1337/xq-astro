---
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Рассчитать стоимость проекта", 
  subtitle = "Заполните поля ниже, и мы свяжемся с вами в течение часа с детальным коммерческим предложением." 
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<section class="section contact-section" id="contact">
  <div class="container">
    <div class="contact-grid">
      
      <!-- Left Info Block -->
      <div class="contact-info-block">
        <span class="eyebrow">СВЯЗАТЬСЯ //</span>
        <h2>Давайте создавать вместе</h2>
        <p class="contact-lead">
          Мы открыты для съемок, записи подкастов и проектов любой сложности. Напишите нам, чтобы обсудить детали и составить смету.
        </p>

        <div class="contact-details">
          <div class="detail-row">
            <span class="detail-label">Адрес студии</span>
            <span class="detail-val">Екатеринбург, ул. Ботаническая 19</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Телефон</span>
            <a href="tel:+79923410520" class="detail-val">+7 992 341-05-20</a>
          </div>
          <div class="detail-row">
            <span class="detail-label">Email</span>
            <a href="mailto:hvaliteq@gmail.com" class="detail-val">hvaliteq@gmail.com</a>
          </div>
        </div>
      </div>

      <!-- Traditional Redesigned Form Block -->
      <div class="contact-form-block glass" id="form-container">
        <h3>{title}</h3>
        <p class="form-desc">{subtitle}</p>

        <form id="project-form" class="project-form" novalidate>
          
          <!-- Category Selector Pills -->
          <div class="form-group">
            <span class="form-label-mono">Выбрать формат //</span>
            <div class="format-pills" role="group" aria-label="Формат проекта">
              <button type="button" class="pill-btn active" data-value="видеопроизводство">Видеопроизводство</button>
              <button type="button" class="pill-btn" data-value="студия подкастов">Студия подкастов</button>
              <button type="button" class="pill-btn" data-value="реклама и клипы">Реклама & Клипы</button>
              <button type="button" class="pill-btn" data-value="монтаж и графика">Монтаж & Графика</button>
            </div>
            <!-- Hidden input to hold chosen format value -->
            <input type="hidden" name="project_format" id="format-hidden-input" value="видеопроизводство" />
          </div>

          <!-- Structured Form Fields -->
          <div class="form-fields-grid">
            <div class="form-group">
              <label for="name-input" class="form-label-mono">01 // Ваше имя</label>
              <input 
                type="text" 
                id="name-input" 
                name="name" 
                class="form-input" 
                placeholder="Иван Иванов" 
                required 
              />
              <span class="error-msg" id="name-error">Пожалуйста, укажите имя</span>
            </div>

            <div class="form-group">
              <label for="phone-input" class="form-label-mono">02 // Номер телефона</label>
              <input 
                type="tel" 
                id="phone-input" 
                name="phone" 
                class="form-input" 
                placeholder="+7 (999) 000-00-00" 
                required 
              />
              <span class="error-msg" id="phone-error">Введите корректный номер телефона</span>
            </div>

            <div class="form-group">
              <label for="email-input" class="form-label-mono">03 // Электронная почта</label>
              <input 
                type="email" 
                id="email-input" 
                name="email" 
                class="form-input" 
                placeholder="ivan@example.ru" 
                required 
              />
              <span class="error-msg" id="email-error">Введите корректный адрес почты</span>
            </div>

            <div class="form-group">
              <label for="message-textarea" class="form-label-mono">04 // Описание проекта</label>
              <textarea 
                id="message-textarea" 
                name="message" 
                class="form-textarea" 
                placeholder="Расскажите о вашей задаче, хронометраже, целях съемок..." 
                rows="3"
              ></textarea>
            </div>
          </div>

          <div class="form-agreement">
            <label class="checkbox-label">
              <input type="checkbox" id="agreement-checkbox" name="agreement" required />
              <span class="checkbox-text">Я согласен с <a href={`${base}privacy`} target="_blank" class="accent-link">политикой конфиденциальности</a></span>
            </label>
            <span class="error-msg" id="agreement-error">Необходимо ваше согласие</span>
          </div>

          <button type="submit" class="btn btn-primary submit-btn">
            ОТПРАВИТЬ ЗАЯВКУ //
          </button>
        </form>

        <!-- Success Screen Overlay -->
        <div class="success-overlay" id="success-overlay">
          <div class="success-content">
            <div class="success-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
            </div>
            <h4>Заявка успешно отправлена!</h4>
            <p>Мы получили вашу информацию и свяжемся с вами в течение часа для детального обсуждения.</p>
            <button id="reset-form-btn" class="btn btn-secondary btn-sm">Отправить еще раз</button>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('project-form') as HTMLFormElement;
  const nameInput = document.getElementById('name-input') as HTMLInputElement;
  const phoneInput = document.getElementById('phone-input') as HTMLInputElement;
  const emailInput = document.getElementById('email-input') as HTMLInputElement;
  const agreement = document.getElementById('agreement-checkbox') as HTMLInputElement;
  const successOverlay = document.getElementById('success-overlay');
  const resetBtn = document.getElementById('reset-form-btn');
  const formatInput = document.getElementById('format-hidden-input') as HTMLInputElement;
  const pillBtns = document.querySelectorAll('.pill-btn');

  // Format Pills Interaction
  pillBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      pillBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const val = btn.getAttribute('data-value');
      if (val && formatInput) {
        formatInput.value = val;
      }
    });
  });

  function validateField(input: HTMLInputElement, errorId: string): boolean {
    const errorEl = document.getElementById(errorId);
    const isValid = input.checkValidity();

    if (!isValid) {
      input.classList.add('invalid');
      errorEl?.classList.add('show');
    } else {
      input.classList.remove('invalid');
      errorEl?.classList.remove('show');
    }
    return isValid;
  }

  nameInput?.addEventListener('blur', () => validateField(nameInput, 'name-error'));
  phoneInput?.addEventListener('blur', () => validateField(phoneInput, 'phone-error'));
  emailInput?.addEventListener('blur', () => validateField(emailInput, 'email-error'));
  agreement?.addEventListener('change', () => {
    const err = document.getElementById('agreement-error');
    if (agreement.checked) {
      err?.classList.remove('show');
    } else {
      err?.classList.add('show');
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const isNameValid = validateField(nameInput, 'name-error');
    const isPhoneValid = validateField(phoneInput, 'phone-error');
    const isEmailValid = validateField(emailInput, 'email-error');
    
    const isAgreementValid = agreement.checked;
    const agreementError = document.getElementById('agreement-error');
    if (!isAgreementValid) {
      agreementError?.classList.add('show');
    } else {
      agreementError?.classList.remove('show');
    }

    if (isNameValid && isPhoneValid && isEmailValid && isAgreementValid) {
      const formData = new FormData(form);
      console.log('Form submission completed:', Object.fromEntries(formData));

      if (successOverlay) {
        successOverlay.classList.add('active');
      }
    }
  });

  resetBtn?.addEventListener('click', () => {
    form?.reset();
    successOverlay?.classList.remove('active');
    
    // Clear validation styles
    document.querySelectorAll('.form-input').forEach(el => el.classList.remove('invalid'));
    document.querySelectorAll('.error-msg').forEach(el => el.classList.remove('show'));
    
    // Reset format pills
    pillBtns.forEach(b => b.classList.remove('active'));
    pillBtns[0].classList.add('active');
    if (formatInput) {
      formatInput.value = 'видеопроизводство';
    }
  });
</script>

<style>
  .contact-section {
    background-color: var(--color-bg-darkest);
    border-top: 1px solid var(--color-border);
    position: relative;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xxl);
    align-items: flex-start;
  }

  .contact-info-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 480px;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-top: var(--space-md);
  }

  .detail-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .detail-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .detail-val {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .detail-val:hover {
    color: var(--color-accent);
  }

  /* Traditional structured Form style */
  .contact-form-block {
    position: relative;
    border-radius: var(--border-radius-md);
    padding: var(--space-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .contact-form-block h3 {
    font-size: 1.5rem;
    margin-bottom: var(--space-xxs);
    letter-spacing: -0.01em;
  }

  .form-desc {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xl);
    line-height: 1.5;
  }

  .project-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .form-label-mono {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xs);
  }

  /* Format Pills */
  .format-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .pill-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.4rem 1.0rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .pill-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .pill-btn.active {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background-color: rgba(255, 255, 255, 0.05);
  }

  /* Fields Layout Grid */
  .form-fields-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-input {
    width: 100%;
    background: var(--color-bg-darkest);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 0.85rem 1.0rem;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 400;
    transition: all var(--transition-normal);
  }

  .form-input::placeholder {
    color: var(--color-text-muted);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    background: rgba(255, 255, 255, 0.01);
  }

  .form-input.invalid {
    border-color: #ef4444;
    background: rgba(239, 68, 68, 0.02);
  }

  .form-textarea {
    width: 100%;
    background: var(--color-bg-darkest);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 0.85rem 1.0rem;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 400;
    resize: vertical;
    transition: all var(--transition-normal);
  }

  .form-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    background: rgba(255, 255, 255, 0.01);
  }

  .error-msg {
    display: none;
    font-size: 0.72rem;
    color: #ef4444;
    margin-top: 4px;
    font-family: var(--font-mono);
  }

  .error-msg.show {
    display: block;
  }

  .form-agreement {
    margin-top: var(--space-xs);
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    cursor: pointer;
  }

  .checkbox-label input {
    margin-top: 0.3rem;
  }

  .checkbox-text {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .accent-link {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .submit-btn {
    align-self: flex-start;
    padding: 0.85rem 2.0rem;
    font-size: 0.78rem;
  }

  /* Success screen style */
  .success-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-color: var(--color-bg-card);
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl);
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition: all var(--transition-normal);
  }

  .success-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .success-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    max-width: 380px;
  }

  .success-icon {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.03);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-primary);
  }

  .success-content h4 {
    font-size: 1.35rem;
    font-weight: 700;
  }

  .success-content p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Media Queries */
  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--space-xxl);
    }
    .contact-form-block {
      padding: var(--space-xxl);
    }
  }
</style>
