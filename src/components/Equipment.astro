---
---
<section class="relative py-[clamp(5rem,9vw,9rem)] bg-bg-darkest border-t border-border z-10" id="equipment">
  <!-- Glow -->
  <div class="absolute top-1/2 -right-32 w-72 h-72 bg-glow-violet rounded-full blur-3xl animate-float pointer-events-none"></div>

  <div class="w-full max-w-[1200px] mx-auto px-8">
    <div class="mb-12 max-w-[600px]" data-reveal>
      <span class="font-mono text-[0.7rem] font-normal tracking-[0.15em] text-accent inline-flex items-center gap-2 mb-4 uppercase before:content-['//'] before:text-text-muted">Оборудование //</span>
      <h2>Профессиональное оборудование</h2>
      <p class="text-[1.05rem] text-text-secondary">
        Качество звука и картинки — наш главный приоритет. Мы используем передовую технику мировых брендов.
      </p>
    </div>

    <!-- Tabs Container -->
    <div class="flex flex-col gap-8" data-reveal data-reveal-delay="2">
      <div class="flex border-b border-border gap-8" role="tablist" aria-label="Спецификация оборудования">
        <button class="tab-btn active relative bg-transparent border-none text-text-secondary font-mono text-sm font-medium tracking-[0.1em] pb-4 cursor-pointer transition-colors duration-200 hover:text-accent [&.active]:text-accent after:absolute after:bottom-0 after:left-0 after:w-full after:h-[1.5px] after:bg-accent after:origin-right after:scale-x-0 after:transition-transform after:duration-400 [&.active]:after:scale-x-100 [&.active]:after:origin-left [&.active]:after:shadow-[0_0_8px_rgba(200,162,123,0.3)]" role="tab" aria-selected="true" data-tab="audio">
          АУДИОЗАПИСЬ
        </button>
        <button class="tab-btn relative bg-transparent border-none text-text-secondary font-mono text-sm font-medium tracking-[0.1em] pb-4 cursor-pointer transition-colors duration-200 hover:text-accent [&.active]:text-accent after:absolute after:bottom-0 after:left-0 after:w-full after:h-[1.5px] after:bg-accent after:origin-right after:scale-x-0 after:transition-transform after:duration-400 [&.active]:after:scale-x-100 [&.active]:after:origin-left [&.active]:after:shadow-[0_0_8px_rgba(200,162,123,0.3)]" role="tab" aria-selected="false" data-tab="video">
          ВИДЕОСЪЕМКА
        </button>
      </div>

      <div class="relative">
        <!-- Audio Tab Panel -->
        <div class="tab-panel active" id="tab-audio" role="tabpanel">
          <div class="grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr] gap-8 md:gap-12 items-center">
            <div class="flex flex-col gap-4">
              <h3 class="font-display text-[1.35rem] font-bold uppercase tracking-[-0.01em]">Микрофоны студийного стандарта</h3>
              <p class="text-[0.95rem] leading-relaxed text-text-secondary">
                Мы используем легендарные микрофоны <strong>AKG</strong> и <strong>SHURE</strong> — мировые стандарты точности и надежности звука. Их выбирают ведущие подкастеры и музыканты для эфиров и студийных сессий.
              </p>
              <p class="text-[0.95rem] leading-relaxed text-text-secondary">
                В связке с ними работает профессиональный аудиоинтерфейс <strong>Steinberg UR22C</strong>, передающий чистые басы, прозрачные высокие частоты и детальный голос без задержек.
              </p>
            </div>
            
            <div class="flex flex-col gap-3">
              <div class="rounded bg-glass border border-border backdrop-blur-[20px] px-6 py-4 flex flex-col gap-0.5 transition-all duration-300 hover:border-white/15 hover:shadow-[0_0_12px_rgba(200,162,123,0.05)]">
                <span class="font-mono text-[0.65rem] uppercase text-accent font-medium tracking-[0.1em]">Микрофоны</span>
                <span class="text-base font-medium text-text-primary">Shure SM7B / AKG C214</span>
              </div>
              <div class="rounded bg-glass border border-border backdrop-blur-[20px] px-6 py-4 flex flex-col gap-0.5 transition-all duration-300 hover:border-white/15 hover:shadow-[0_0_12px_rgba(200,162,123,0.05)]">
                <span class="font-mono text-[0.65rem] uppercase text-accent font-medium tracking-[0.1em]">Аудиоинтерфейс</span>
                <span class="text-base font-medium text-text-primary">Steinberg UR22C</span>
              </div>
              <div class="rounded bg-glass border border-border backdrop-blur-[20px] px-6 py-4 flex flex-col gap-0.5 transition-all duration-300 hover:border-white/15 hover:shadow-[0_0_12px_rgba(200,162,123,0.05)]">
                <span class="font-mono text-[0.65rem] uppercase text-accent font-medium tracking-[0.1em]">Предусиление</span>
                <span class="text-base font-medium text-text-primary">Cloudlifter CL-1</span>
              </div>
              <div class="rounded bg-glass border border-border backdrop-blur-[20px] px-6 py-4 flex flex-col gap-0.5 transition-all duration-300 hover:border-white/15 hover:shadow-[0_0_12px_rgba(200,162,123,0.05)]">
                <span class="font-mono text-[0.65rem] uppercase text-accent font-medium tracking-[0.1em]">Мониторинг</span>
                <span class="text-base font-medium text-text-primary">Beyerdynamic DT 770 Pro</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Video Tab Panel -->
        <div class="tab-panel hidden" id="tab-video" role="tabpanel">
          <div class="grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr] gap-8 md:gap-12 items-center">
            <div class="flex flex-col gap-4">
              <h3 class="font-display text-[1.35rem] font-bold uppercase tracking-[-0.01em]">Четкость и глубина картинки</h3>
              <p class="text-[0.95rem] leading-relaxed text-text-secondary">
                Для съемки видеоподкастов мы задействуем камеры <strong>Sony A7M3</strong> и <strong>Sony ZV-E10</strong> с качественной оптикой. Это гарантирует сочные цвета, резкую автофокусировку на глазах и красивое размытие фона.
              </p>
              <p class="text-[0.95rem] leading-relaxed text-text-secondary">
                Для многокамерной съемки в реальном времени мы используем микшер <strong>AVMATRIX Shark H4 Plus</strong>, позволяющий мгновенно переключать планы, накладывать эффекты и монтировать видео прямо во время эфира.
              </p>
            </div>

            <div class="flex flex-col gap-3">
              <div class="rounded bg-glass border border-border backdrop-blur-[20px] px-6 py-4 flex flex-col gap-0.5 transition-all duration-300 hover:border-white/15 hover:shadow-[0_0_12px_rgba(200,162,123,0.05)]">
                <span class="font-mono text-[0.65rem] uppercase text-accent font-medium tracking-[0.1em]">Камеры</span>
                <span class="text-base font-medium text-text-primary">Sony A7M3 (Full Frame) / Sony ZV-E10</span>
              </div>
              <div class="rounded bg-glass border border-border backdrop-blur-[20px] px-6 py-4 flex flex-col gap-0.5 transition-all duration-300 hover:border-white/15 hover:shadow-[0_0_12px_rgba(200,162,123,0.05)]">
                <span class="font-mono text-[0.65rem] uppercase text-accent font-medium tracking-[0.1em]">Оптика</span>
                <span class="text-base font-medium text-text-primary">Sony FE 24-70mm f/2.8 GM / Sigma 30mm f/1.4</span>
              </div>
              <div class="rounded bg-glass border border-border backdrop-blur-[20px] px-6 py-4 flex flex-col gap-0.5 transition-all duration-300 hover:border-white/15 hover:shadow-[0_0_12px_rgba(200,162,123,0.05)]">
                <span class="font-mono text-[0.65rem] uppercase text-accent font-medium tracking-[0.1em]">Видеомикшер</span>
                <span class="text-base font-medium text-text-primary">AVMATRIX Shark H4 Plus</span>
              </div>
              <div class="rounded bg-glass border border-border backdrop-blur-[20px] px-6 py-4 flex flex-col gap-0.5 transition-all duration-300 hover:border-white/15 hover:shadow-[0_0_12px_rgba(200,162,123,0.05)]">
                <span class="font-mono text-[0.65rem] uppercase text-accent font-medium tracking-[0.1em]">Освещение</span>
                <span class="text-base font-medium text-text-primary">Aputure Amaran 200d / RGB LED Панели</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const tabId = btn.getAttribute('data-tab');

      tabPanels.forEach(panel => {
        if (panel.id === `tab-${tabId}`) {
          panel.classList.remove('hidden');
          panel.classList.add('active');
          panel.style.animation = 'fade-in-up 0.4s ease forwards';
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('active');
          panel.style.animation = '';
        }
      });
    });
  });
</script>
