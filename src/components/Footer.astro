---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<footer class="main-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={base} class="logo">
        <img src={`${base}images/logo.svg`} alt="Quality Media Logo" width="130" height="22" />
      </a>
      <p class="brand-desc">
        Студия видеопроизводства и подкастов полного цикла. Создаем истории, которые вдохновляют и продают.
      </p>
      <div class="social-links">
        <a href="https://t.me/quality_media" target="_blank" rel="noopener noreferrer" aria-label="Telegram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.198 2.502a.25.25 0 0 0-.28-.02L2.091 10.985a.25.25 0 0 0-.022.454l4.28 1.902a.25.25 0 0 0 .252-.016l13.56-9.04a.125.125 0 0 1 .166.183l-10.94 10.22a.25.25 0 0 0-.063.155l-.47 4.194a.25.25 0 0 0 .463.11l2.42-3.13a.25.25 0 0 0 .04-.265l-2.07-4.22" /><path d="M21.198 2.502 10.33 16.945" /></svg>
        </a>
        <a href="https://wa.me/79923410520" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
        </a>
        <a href="https://youtube.com/@quality_media" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17z" /><polygon points="10 15 15 12 10 9 10 15" /></svg>
        </a>
      </div>
    </div>

    <div class="footer-links">
      <h3 class="footer-title">Разделы</h3>
      <ul>
        <li><a href={base}>Видеопродакшн</a></li>
        <li><a href={`${base}podcast`}>Студия подкастов</a></li>
        <li><a href="#contact">Рассчитать проект</a></li>
      </ul>
    </div>

    <div class="footer-contacts">
      <h3 class="footer-title">Контакты</h3>
      <div class="contact-item">
        <span class="contact-label">Телефон:</span>
        <a href="tel:+79923410520" class="contact-val">+7 (992) 341-05-20</a>
      </div>
      <div class="contact-item">
        <span class="contact-label">Email:</span>
        <a href="mailto:hvaliteq@gmail.com" class="contact-val">hvaliteq@gmail.com</a>
      </div>
      <div class="contact-item">
        <span class="contact-label">Адрес:</span>
        <span class="contact-val address-val">
          г. Екатеринбург, ул. Ботаническая 19<br />
          <span class="address-desc">(Вход с улицы Ботаническая, во дворе)</span>
        </span>
      </div>
      <a 
        href="https://yandex.ru/maps/-/CDT0UP42" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-secondary map-btn"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" /><line x1="9" y1="3" x2="9" y2="18" /><line x1="15" y1="6" x2="15" y2="21" /></svg>
        Проложить маршрут
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-flex">
      <p>&copy; {currentYear} Хвалите Quality Production. Все права защищены.</p>
      <a href={`${base}privacy`} class="privacy-link">Политика конфиденциальности</a>
    </div>
  </div>
</footer>

<style>
  .main-footer {
    background-color: var(--color-bg-dark);
    border-top: 1px solid var(--color-border);
    padding: var(--space-xxl) 0 0 0;
    position: relative;
    z-index: 10;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xxl);
    padding-bottom: var(--space-xxl);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .brand-desc {
    font-size: 0.95rem;
    max-width: 320px;
  }

  .social-links {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-xs);
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-secondary);
  }

  .social-links a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-2px);
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-lg);
    color: var(--color-text-primary);
  }

  .footer-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-links a {
    color: var(--color-text-secondary);
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .footer-contacts {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
  }

  .contact-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .contact-val {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .contact-val:hover {
    color: var(--color-primary);
  }

  .address-val {
    line-height: 1.5;
  }

  .address-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .map-btn {
    align-self: flex-start;
    padding: 0.6rem 1.2rem;
    font-size: 0.85rem;
    margin-top: var(--space-xs);
  }

  .footer-bottom {
    background-color: var(--color-bg-darkest);
    border-top: 1px solid var(--color-border);
    padding: var(--space-lg) 0;
  }

  .footer-bottom-flex {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .privacy-link:hover {
    color: var(--color-primary);
  }

  /* Media Queries */
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 2fr;
      gap: var(--space-xl);
    }
    
    .footer-bottom-flex {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
