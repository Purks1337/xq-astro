---
const currentYear = new Date().getFullYear();
---

<footer class="relative bg-bg-dark border-t border-border pt-12 z-10">
  <!-- Top glow line -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-px bg-gradient-to-r from-transparent via-accent/30 to-transparent"></div>

  <div class="w-full max-w-[1200px] mx-auto px-8 grid grid-cols-1 md:grid-cols-[2fr_1fr_2fr] gap-12 md:gap-8 pb-12">
    <div class="flex flex-col gap-4">
      <a href="/" class="inline-block">
        <img src="/images/logo.svg" alt="Quality Media Logo" width="130" height="22" />
      </a>
      <p class="text-[0.95rem] max-w-[320px]">
        Студия видеопроизводства и подкастов полного цикла. Создаем истории, которые вдохновляют и продают.
      </p>
      <div class="flex gap-4 mt-2">
        <a href="https://t.me/quality_media" target="_blank" rel="noopener noreferrer" aria-label="Telegram" class="flex items-center justify-center w-10 h-10 bg-bg-card border border-border rounded-sm text-text-secondary transition-all duration-300 hover:border-white hover:text-white hover:-translate-y-0.5 hover:shadow-[0_0_16px_rgba(255,255,255,0.08)]">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.198 2.502a.25.25 0 0 0-.28-.02L2.091 10.985a.25.25 0 0 0-.022.454l4.28 1.902a.25.25 0 0 0 .252-.016l13.56-9.04a.125.125 0 0 1 .166.183l-10.94 10.22a.25.25 0 0 0-.063.155l-.47 4.194a.25.25 0 0 0 .463.11l2.42-3.13a.25.25 0 0 0 .04-.265l-2.07-4.22" /><path d="M21.198 2.502 10.33 16.945" /></svg>
        </a>
        <a href="https://wa.me/79923410520" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="flex items-center justify-center w-10 h-10 bg-bg-card border border-border rounded-sm text-text-secondary transition-all duration-300 hover:border-white hover:text-white hover:-translate-y-0.5 hover:shadow-[0_0_16px_rgba(255,255,255,0.08)]">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
        </a>
        <a href="https://youtube.com/@quality_media" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="flex items-center justify-center w-10 h-10 bg-bg-card border border-border rounded-sm text-text-secondary transition-all duration-300 hover:border-white hover:text-white hover:-translate-y-0.5 hover:shadow-[0_0_16px_rgba(255,255,255,0.08)]">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17z" /><polygon points="10 15 15 12 10 9 10 15" /></svg>
        </a>
      </div>
    </div>

    <div>
      <h3 class="font-display text-[1.1rem] font-semibold uppercase tracking-[0.1em] mb-6 text-text-primary">Разделы</h3>
      <ul class="list-none flex flex-col gap-3">
        <li><a href="/" class="text-text-secondary hover:text-white transition-colors duration-200">Видеопродакшн</a></li>
        <li><a href="/podcast" class="text-text-secondary hover:text-white transition-colors duration-200">Студия подкастов</a></li>
        <li><a href="#contact" class="text-text-secondary hover:text-white transition-colors duration-200">Рассчитать проект</a></li>
      </ul>
    </div>

    <div class="flex flex-col gap-4">
      <h3 class="font-display text-[1.1rem] font-semibold uppercase tracking-[0.1em] mb-6 text-text-primary">Контакты</h3>
      <div class="flex flex-col gap-1">
        <span class="text-xs uppercase tracking-[0.1em] text-text-muted">Телефон:</span>
        <a href="tel:+79923410520" class="text-text-primary font-medium hover:text-accent transition-colors duration-200">+7 (992) 341-05-20</a>
      </div>
      <div class="flex flex-col gap-1">
        <span class="text-xs uppercase tracking-[0.1em] text-text-muted">Email:</span>
        <a href="mailto:hvaliteq@gmail.com" class="text-text-primary font-medium hover:text-accent transition-colors duration-200">hvaliteq@gmail.com</a>
      </div>
      <div class="flex flex-col gap-1">
        <span class="text-xs uppercase tracking-[0.1em] text-text-muted">Адрес:</span>
        <span class="text-text-primary font-medium leading-relaxed">
          г. Екатеринбург, ул. Ботаническая 19<br />
          <span class="text-sm text-text-secondary">(Вход с улицы Ботаническая, во дворе)</span>
        </span>
      </div>
      <a 
        href="https://yandex.ru/maps/-/CDT0UP42" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="self-start inline-flex items-center gap-2 px-5 py-2.5 font-display text-sm font-bold uppercase tracking-[0.1em] rounded-sm border border-border text-text-primary bg-transparent transition-all duration-400 hover:border-white hover:bg-white/[0.03] mt-2"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" /><line x1="9" y1="3" x2="9" y2="18" /><line x1="15" y1="6" x2="15" y2="21" /></svg>
        Проложить маршрут
      </a>
    </div>
  </div>

  <div class="bg-bg-darkest border-t border-border py-6">
    <div class="w-full max-w-[1200px] mx-auto px-8 flex flex-col md:flex-row gap-4 items-center md:justify-between text-sm text-text-muted">
      <p>&copy; {currentYear} Хвалите Quality Production. Все права защищены.</p>
      <a href="/privacy" class="hover:text-white transition-colors duration-200">Политика конфиденциальности</a>
    </div>
  </div>
</footer>
