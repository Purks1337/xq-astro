---
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/index.html';
const isPodcast = pathname.startsWith('/podcast');
---

<header class="fixed top-0 left-0 w-full z-100 py-6 border-b border-transparent transition-all duration-400 ease-[cubic-bezier(0.25,1,0.5,1)]" id="main-header">
  <div class="w-full max-w-[1200px] mx-auto px-8 flex items-center justify-between">
    <a href="/" class="flex items-center z-110" aria-label="Quality Media Главная">
      <img src="/images/logo.svg" alt="Quality Media Логотип" width="130" height="22" class="brightness-[0.98]" />
    </a>

    <nav class="hidden lg:block" aria-label="Основная навигация">
      <ul class="flex list-none gap-8">
        <li>
          <a href="/" class:list={[
            'font-mono text-xs font-normal tracking-[0.15em] inline-flex items-center gap-1.5 py-2 transition-colors duration-200',
            isHome ? 'text-text-primary' : 'text-text-secondary hover:text-text-primary'
          ]}>
            <span class:list={[
              'w-1 h-1 rounded-full bg-white transition-all duration-200',
              isHome ? 'opacity-100 scale-100 shadow-[0_0_6px_var(--color-primary)]' : 'opacity-0 scale-50'
            ]}></span>
            ВИДЕО
          </a>
        </li>
        <li>
          <a href="/podcast" class:list={[
            'font-mono text-xs font-normal tracking-[0.15em] inline-flex items-center gap-1.5 py-2 transition-colors duration-200',
            isPodcast ? 'text-text-primary' : 'text-text-secondary hover:text-text-primary'
          ]}>
            <span class:list={[
              'w-1 h-1 rounded-full bg-white transition-all duration-200',
              isPodcast ? 'opacity-100 scale-100 shadow-[0_0_6px_var(--color-primary)]' : 'opacity-0 scale-50'
            ]}></span>
            ПОДКАСТЫ
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-6 z-110">
      <a href="tel:+79923410520" class="font-mono text-xs text-text-primary tracking-[0.05em] hover:text-primary-hover transition-colors duration-200">
        <span class="text-text-muted">ТЕЛ //</span> +7 992 341-05-20
      </a>
      <a href="#contact" class="hidden md:inline-flex items-center justify-center px-4 py-2 font-display text-[0.72rem] font-bold uppercase tracking-[0.1em] rounded-sm border border-border text-text-primary bg-transparent transition-all duration-400 hover:border-white hover:bg-white/[0.03] hover:shadow-[0_0_20px_rgba(255,255,255,0.06)]">
        ОЦЕНИТЬ ПРОЕКТ
      </a>
      <button class="flex lg:hidden flex-col justify-between w-[22px] h-[14px] bg-transparent border-none cursor-pointer p-0 group" id="burger-btn" aria-label="Открыть меню" aria-expanded="false">
        <span class="w-full h-px bg-text-primary transition-all duration-200 origin-center group-[.active]:translate-y-[6.5px] group-[.active]:rotate-45"></span>
        <span class="w-full h-px bg-text-primary transition-all duration-200 group-[.active]:opacity-0"></span>
        <span class="w-full h-px bg-text-primary transition-all duration-200 origin-center group-[.active]:-translate-y-[6.5px] group-[.active]:-rotate-45"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Overlay Menu -->
  <div class="fixed inset-0 bg-bg-darkest z-105 opacity-0 invisible transition-all duration-400 flex items-center justify-center aria-hidden:opacity-0 [&.active]:opacity-100 [&.active]:visible" id="mobile-menu" aria-hidden="true">
    <!-- Glow decorations -->
    <div class="absolute top-1/4 -left-20 w-64 h-64 bg-glow-amber rounded-full blur-3xl animate-glow-pulse"></div>
    <div class="absolute bottom-1/4 -right-20 w-48 h-48 bg-glow-violet rounded-full blur-3xl animate-float"></div>

    <div class="flex flex-col items-center justify-between h-[55vh] p-8">
      <ul class="list-none text-center flex flex-col gap-8">
        <li>
          <a href="/" class:list={[
            'mobile-nav-link font-display text-4xl font-bold inline-flex items-center gap-3 transition-colors duration-200',
            isHome ? 'text-text-primary' : 'text-text-secondary hover:text-text-primary'
          ]}>
            <span class:list={[
              'w-2 h-2 rounded-full bg-white transition-all duration-200',
              isHome ? 'opacity-100 scale-100' : 'opacity-0 scale-50'
            ]}></span>
            ВИДЕО
          </a>
        </li>
        <li>
          <a href="/podcast" class:list={[
            'mobile-nav-link font-display text-4xl font-bold inline-flex items-center gap-3 transition-colors duration-200',
            isPodcast ? 'text-text-primary' : 'text-text-secondary hover:text-text-primary'
          ]}>
            <span class:list={[
              'w-2 h-2 rounded-full bg-white transition-all duration-200',
              isPodcast ? 'opacity-100 scale-100' : 'opacity-0 scale-50'
            ]}></span>
            ПОДКАСТЫ
          </a>
        </li>
      </ul>
      <div class="flex flex-col items-center gap-4 w-full">
        <a href="tel:+79923410520" class="font-mono text-base tracking-[0.05em] text-text-primary">+7 992 341-05-20</a>
        <a href="#contact" class="mobile-cta w-full max-w-[280px] inline-flex items-center justify-center px-8 py-3.5 font-display text-sm font-bold uppercase tracking-[0.1em] rounded-sm bg-white text-bg-darkest transition-all duration-400 hover:bg-primary-hover hover:-translate-y-0.5">ОЦЕНИТЬ ПРОЕКТ</a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  const burgerBtn = document.getElementById('burger-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link, .mobile-cta');

  // Handle scroll class — add glassmorphism
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });

  // Toggle mobile menu
  function toggleMenu() {
    const isExpanded = burgerBtn?.getAttribute('aria-expanded') === 'true';
    burgerBtn?.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
    burgerBtn?.classList.toggle('active');
    
    if (mobileMenu) {
      const isHidden = mobileMenu.getAttribute('aria-hidden') === 'true';
      mobileMenu.setAttribute('aria-hidden', isHidden ? 'false' : 'true');
      mobileMenu.classList.toggle('active');
      document.body.classList.toggle('no-scroll');
    }
  }

  burgerBtn?.addEventListener('click', toggleMenu);

  // Close menu on link click
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      burgerBtn?.setAttribute('aria-expanded', 'false');
      burgerBtn?.classList.remove('active');
      mobileMenu?.setAttribute('aria-hidden', 'true');
      mobileMenu?.classList.remove('active');
      document.body.classList.remove('no-scroll');
    });
  });
</script>

<style>
  /* Scrolled glassmorphism state — needs CSS for dynamic class */
  .main-header:global(.scrolled) {
    background: var(--color-glass);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom-color: var(--color-border);
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  #main-header.scrolled {
    background: var(--color-glass);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom-color: var(--color-border);
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
</style>
