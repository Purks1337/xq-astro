---
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const isHome = pathname === base || pathname === base + 'index.html';
const isPodcast = pathname.startsWith(base + 'podcast');
---

<header class="main-header" id="main-header">
  <div class="container header-container">
    <a href={base} class="logo" aria-label="Quality Media Главная">
      <img src={`${base}images/logo.svg`} alt="Quality Media Логотип" width="130" height="22" />
    </a>

    <nav class="desktop-nav" aria-label="Основная навигация">
      <ul class="nav-links">
        <li>
          <a href={base} class:list={['nav-link', { active: isHome }]}>
            <span class="dot-indicator"></span>
            ВИДЕО
          </a>
        </li>
        <li>
          <a href={`${base}podcast`} class:list={['nav-link', { active: isPodcast }]}>
            <span class="dot-indicator"></span>
            ПОДКАСТЫ
          </a>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <a href="tel:+79923410520" class="phone-link">
        <span class="phone-label">ТЕЛ //</span> +7 992 341-05-20
      </a>
      <a href="#contact" class="btn btn-secondary btn-header-cta">
        ОЦЕНИТЬ ПРОЕКТ
      </a>
      <button class="burger-btn" id="burger-btn" aria-label="Открыть меню" aria-expanded="false">
        <span class="burger-line"></span>
        <span class="burger-line"></span>
        <span class="burger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Overlay Menu -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-content">
      <ul class="mobile-nav-links">
        <li>
          <a href={base} class:list={['mobile-nav-link', { active: isHome }]}>
            <span class="dot-indicator"></span>
            ВИДЕО
          </a>
        </li>
        <li>
          <a href={`${base}podcast`} class:list={['mobile-nav-link', { active: isPodcast }]}>
            <span class="dot-indicator"></span>
            ПОДКАСТЫ
          </a>
        </li>
      </ul>
      <div class="mobile-menu-footer">
        <a href="tel:+79923410520" class="mobile-phone">+7 992 341-05-20</a>
        <a href="#contact" class="btn btn-primary mobile-cta">ОЦЕНИТЬ ПРОЕКТ</a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  const burgerBtn = document.getElementById('burger-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link, .mobile-cta');

  // Handle scroll class
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });

  // Toggle mobile menu
  function toggleMenu() {
    const isExpanded = burgerBtn?.getAttribute('aria-expanded') === 'true';
    burgerBtn?.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
    burgerBtn?.classList.toggle('active');
    
    if (mobileMenu) {
      const isHidden = mobileMenu.getAttribute('aria-hidden') === 'true';
      mobileMenu.setAttribute('aria-hidden', isHidden ? 'false' : 'true');
      mobileMenu.classList.toggle('active');
      document.body.classList.toggle('no-scroll');
    }
  }

  burgerBtn?.addEventListener('click', toggleMenu);

  // Close menu on link click
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      burgerBtn?.setAttribute('aria-expanded', 'false');
      burgerBtn?.classList.remove('active');
      mobileMenu?.setAttribute('aria-hidden', 'true');
      mobileMenu?.classList.remove('active');
      document.body.classList.remove('no-scroll');
    });
  });
</script>

<style>
  .main-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: var(--space-lg) 0;
    border-bottom: 1px solid transparent;
    transition: all var(--transition-normal);
  }

  .main-header.scrolled {
    background: var(--color-glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-md) 0;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    z-index: 110;
  }

  .logo img {
    filter: brightness(0.98);
  }

  .desktop-nav {
    display: none;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: var(--space-xl);
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-secondary);
    letter-spacing: 0.15em;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--space-xs) 0;
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  .dot-indicator {
    width: 4px;
    height: 4px;
    background-color: var(--color-primary);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.5);
    transition: all var(--transition-fast);
  }

  .nav-link.active {
    color: var(--color-primary);
  }

  .nav-link.active .dot-indicator, .nav-link:hover .dot-indicator {
    opacity: 1;
    transform: scale(1);
    box-shadow: 0 0 6px var(--color-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    z-index: 110;
  }

  .phone-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-primary);
    letter-spacing: 0.05em;
  }

  .phone-label {
    color: var(--color-text-muted);
  }

  .phone-link:hover {
    color: var(--color-primary);
  }

  .btn-header-cta {
    display: none;
    padding: 0.5rem 1.0rem;
    font-size: 0.72rem;
  }

  .burger-btn {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 22px;
    height: 14px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .burger-line {
    width: 100%;
    height: 1px;
    background-color: var(--color-text-primary);
    transition: all var(--transition-fast);
  }

  .burger-btn.active .burger-line:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .burger-btn.active .burger-line:nth-child(2) {
    opacity: 0;
  }

  .burger-btn.active .burger-line:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: var(--color-bg-darkest);
    z-index: 105;
    opacity: 0;
    visibility: hidden;
    transition: all var(--transition-normal);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: 55vh;
    padding: var(--space-xl);
  }

  .mobile-nav-links {
    list-style: none;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .mobile-nav-link {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-text-primary);
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .mobile-nav-link .dot-indicator {
    width: 8px;
    height: 8px;
  }

  .mobile-nav-link.active {
    color: var(--color-primary);
  }

  .mobile-nav-link.active .dot-indicator {
    opacity: 1;
    transform: scale(1);
  }

  .mobile-menu-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    width: 100%;
  }

  .mobile-phone {
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.05em;
  }

  .mobile-cta {
    width: 100%;
    max-width: 280px;
  }

  /* Media Queries */
  @media (min-width: 768px) {
    .btn-header-cta {
      display: inline-flex;
    }
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
    }
    
    .burger-btn {
      display: none;
    }

    .mobile-menu {
      display: none;
    }
  }

  :global(body.no-scroll) {
    overflow: hidden;
  }
</style>
