---
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Хвалите Quality Production", 
  subtitle = "Профессиональная студия видеопродакшна полного цикла. Создаем рекламные ролики, музыкальные клипы, интервью и трансляции от идеи до финального монтажа." 
} = Astro.props;
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-text-block">
      <span class="eyebrow">Production Studio</span>
      <h1>{title}</h1>
      <p class="hero-subtitle">{subtitle}</p>
      
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">
          Рассчитать проект
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
        </a>
        <a href="#portfolio" class="btn btn-secondary">Смотреть работы</a>
      </div>
    </div>

    <!-- Premium Showreel Container -->
    <div class="showreel-wrapper">
      <div class="viewfinder-frame">
        <!-- Viewfinder UI details -->
        <span class="vf-corner top-left"></span>
        <span class="vf-corner top-right"></span>
        <span class="vf-corner bottom-left"></span>
        <span class="vf-corner bottom-right"></span>
        <span class="vf-rec-dot"></span>
        <span class="vf-rec-text">REC</span>
        <span class="vf-time">00:00:00:00</span>
        
        <div class="showreel-poster-card" data-video-src="https://kinescope.io/embed/placeholder-showreel">
          <div class="poster-overlay">
            <div class="play-btn-circle">
              <svg class="play-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3" /></svg>
            </div>
            <span class="play-label">Шоурил XQ</span>
          </div>
          <div class="poster-bg"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 120px;
    padding-bottom: var(--space-xxl);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xxl);
    align-items: center;
  }

  .hero-text-block {
    display: flex;
    flex-direction: column;
    z-index: 10;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xxl);
    max-width: 550px;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Showreel Visual Frame */
  .showreel-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    z-index: 10;
  }

  .viewfinder-frame {
    width: 100%;
    max-width: 600px;
    aspect-ratio: 16 / 9;
    border: 1px solid rgba(255, 255, 255, 0.04);
    position: relative;
    padding: var(--space-md);
    background-color: rgba(255, 255, 255, 0.01);
  }

  /* Viewfinder corner lines */
  .vf-corner {
    position: absolute;
    width: 16px;
    height: 16px;
    border-color: rgba(255, 255, 255, 0.3);
    border-style: solid;
    transition: all var(--transition-normal);
  }

  .viewfinder-frame:hover .vf-corner {
    border-color: var(--color-primary);
  }

  .top-left {
    top: 4px;
    left: 4px;
    border-width: 1.5px 0 0 1.5px;
  }

  .top-right {
    top: 4px;
    right: 4px;
    border-width: 1.5px 1.5px 0 0;
  }

  .bottom-left {
    bottom: 4px;
    left: 4px;
    border-width: 0 0 1.5px 1.5px;
  }

  .bottom-right {
    bottom: 4px;
    right: 4px;
    border-width: 0 1.5px 1.5px 0;
  }

  .vf-rec-dot {
    position: absolute;
    top: 14px;
    left: 14px;
    width: 8px;
    height: 8px;
    background-color: #ef4444;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }

  .vf-rec-text {
    position: absolute;
    top: 10px;
    left: 28px;
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: 0.1em;
  }

  .vf-time {
    position: absolute;
    bottom: 10px;
    right: 14px;
    font-family: var(--font-display);
    font-size: 0.65rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.05em;
  }

  .showreel-poster-card {
    width: 100%;
    height: 100%;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    position: relative;
    cursor: pointer;
    background: #101012;
  }

  /* Decorative film lines inside poster card */
  .poster-bg {
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(rgba(255, 107, 0, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 107, 0, 0.05) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.5;
    transition: opacity var(--transition-normal);
  }

  .showreel-poster-card:hover .poster-bg {
    opacity: 0.8;
  }

  .poster-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    background: radial-gradient(circle, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.8) 100%);
  }

  .play-btn-circle {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 30px rgba(255, 107, 0, 0.3);
    transition: all var(--transition-normal);
  }

  .play-icon {
    transform: translateX(2px);
  }

  .showreel-poster-card:hover .play-btn-circle {
    transform: scale(1.1);
    background-color: var(--color-primary-hover);
    box-shadow: 0 0 40px rgba(255, 107, 0, 0.5);
  }

  .play-label {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .showreel-poster-card:hover .play-label {
    color: var(--color-primary);
  }

  @keyframes pulse {
    0% { opacity: 0.3; }
    50% { opacity: 1; }
    100% { opacity: 0.3; }
  }

  /* Media Queries */
  @media (min-width: 480px) {
    .hero-actions {
      flex-direction: row;
    }
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xxl);
    }
  }
</style>
