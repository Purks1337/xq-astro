---
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "ХВАЛИТЕ QUALITY", 
  subtitle = "Профессиональная студия видеопроизводства и записи подкастов в Екатеринбурге. Создаем рекламные ролики, клипы, интервью и трансляции от сценария до финального рендера." 
} = Astro.props;
---

<section class="relative min-h-screen flex items-center justify-center pt-[150px] pb-12 overflow-hidden">
  <!-- Glow Blobs -->
  <div class="absolute -top-32 -right-32 w-[28rem] h-[28rem] bg-glow-amber rounded-full blur-3xl animate-glow-pulse pointer-events-none"></div>
  <div class="absolute top-1/2 -left-40 w-80 h-80 bg-glow-violet rounded-full blur-3xl animate-float pointer-events-none"></div>
  <div class="absolute bottom-20 right-1/4 w-60 h-60 bg-glow-cyan rounded-full blur-3xl animate-float-slow pointer-events-none"></div>

  <div class="w-full max-w-[1200px] mx-auto px-8 flex flex-col gap-12">
    
    <!-- Asymmetric Offset Typography Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-8 lg:gap-12 items-start text-left z-10">
      <div class="flex flex-col" data-reveal>
        <span class="font-mono text-[0.7rem] font-normal tracking-[0.15em] text-accent inline-flex items-center gap-2 mb-4 uppercase before:content-['//'] before:text-text-muted">СТУДИЯ ВИДЕОПРОДАКШНА //</span>
        <h1 class="text-[clamp(2.6rem,7vw,5.2rem)] font-extrabold leading-[0.95] uppercase tracking-[-0.03em] text-text-primary">{title}</h1>
      </div>
      
      <div class="flex flex-col gap-6 justify-end" data-reveal data-reveal-delay="2">
        <p class="text-[clamp(1rem,1.4vw,1.15rem)] leading-relaxed text-text-secondary max-w-[540px]">{subtitle}</p>
        <div class="flex gap-4 max-md:flex-col max-md:w-full">
          <a href="#contact" class="inline-flex items-center justify-center px-6 py-3 font-display text-[0.78rem] font-bold uppercase tracking-[0.1em] rounded-sm bg-white text-bg-darkest transition-all duration-400 hover:bg-primary-hover hover:-translate-y-0.5 hover:shadow-[0_0_30px_rgba(255,255,255,0.15)]">Оценить проект</a>
          <a href="#portfolio" class="inline-flex items-center justify-center px-6 py-3 font-display text-[0.78rem] font-bold uppercase tracking-[0.1em] rounded-sm border border-border text-text-primary bg-transparent transition-all duration-400 hover:border-white hover:bg-white/[0.03]">Наши работы</a>
        </div>
      </div>
    </div>

    <!-- Cinematic Monitor Viewport -->
    <div class="w-full z-10 mt-4" data-reveal data-reveal-delay="3">
      <div class="relative w-full aspect-[21/9] max-md:aspect-video border border-border p-6 max-md:p-3 bg-[rgba(12,14,18,0.4)] shadow-[0_16px_48px_rgba(0,0,0,0.9)] group transition-all duration-500 hover:border-border-hover hover:shadow-[0_16px_64px_rgba(200,162,123,0.08)]">
        <span class="absolute top-1.5 left-1.5 w-3 h-3 border-l border-t border-white/20 transition-all duration-400 group-hover:border-white group-hover:w-[18px] group-hover:h-[18px]"></span>
        <span class="absolute top-1.5 right-1.5 w-3 h-3 border-r border-t border-white/20 transition-all duration-400 group-hover:border-white group-hover:w-[18px] group-hover:h-[18px]"></span>
        <span class="absolute bottom-1.5 left-1.5 w-3 h-3 border-l border-b border-white/20 transition-all duration-400 group-hover:border-white group-hover:w-[18px] group-hover:h-[18px]"></span>
        <span class="absolute bottom-1.5 right-1.5 w-3 h-3 border-r border-b border-white/20 transition-all duration-400 group-hover:border-white group-hover:w-[18px] group-hover:h-[18px]"></span>
        
        <div class="absolute top-2.5 left-6 right-6 flex justify-between font-mono text-[0.65rem] text-text-muted tracking-[0.1em] z-5 max-md:hidden">
          <span class="flex items-center gap-1.5 text-text-primary">
            <span class="w-1.5 h-1.5 bg-red-500 rounded-full animate-flash"></span>ГОТОВНОСТЬ
          </span>
          <span>21:9 ШИРОКИЙ ФОРМАТ</span>
        </div>
        
        <div class="absolute bottom-2.5 left-6 right-6 flex justify-between font-mono text-[0.65rem] text-text-muted tracking-[0.1em] z-5 max-md:hidden">
          <span>24 КАДРА/С</span>
          <span>00:00:00:00</span>
        </div>

        <div class="w-full h-full relative cursor-pointer overflow-hidden bg-bg-darkest" data-video-src="https://kinescope.io/embed/placeholder-showreel">
          <div class="w-full h-full opacity-20 transition-all duration-800 group-hover:scale-[1.02] group-hover:opacity-35">
            <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:33.33%_33.33%]"></div>
            <div class="absolute top-1/2 left-1/2 w-3 h-3 border border-white/15 rounded-full -translate-x-1/2 -translate-y-1/2 before:absolute before:top-1/2 before:-left-1.5 before:w-6 before:h-px before:bg-white/15 after:absolute after:left-1/2 after:-top-1.5 after:w-px after:h-6 after:bg-white/15"></div>
          </div>
          <div class="absolute inset-0 flex items-center justify-center bg-[radial-gradient(circle,rgba(0,0,0,0.2)_0%,rgba(0,0,0,0.7)_100%)] z-4">
            <div class="flex items-center gap-4 px-8 py-4 bg-[rgba(7,9,12,0.8)] border border-border backdrop-blur-[10px] transition-all duration-400 group-hover:border-white group-hover:bg-white group-hover:shadow-[0_0_40px_rgba(255,255,255,0.15)]">
              <span class="text-white flex items-center justify-center transition-transform duration-400 group-hover:text-bg-darkest group-hover:scale-110">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3" /></svg>
              </span>
              <span class="font-mono text-[0.72rem] font-medium tracking-[0.1em] text-text-primary group-hover:text-bg-darkest">СМОТРЕТЬ ШОУРИЛ //</span>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
