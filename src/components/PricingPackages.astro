---
const packages = [
  {
    title: "Аудио Запись",
    price: "от 3 000 ₽",
    period: "в час",
    desc: "Идеально для разговорных подкастов, озвучки или голосовых заметок.",
    features: [
      "Аренда студии с шумоизоляцией",
      "Профессиональные микрофоны (Shure/AKG)",
      "Звукорежиссер во время сессии",
      "Запись многодорожечного аудио",
      "Выдача исходных файлов в день записи"
    ],
    popular: false
  },
  {
    title: "Видео Запись",
    price: "от 5 000 ₽",
    period: "в час",
    desc: "Съемка полноценного видеоподкаста, интервью или Reels для соцсетей.",
    features: [
      "Запись видео на 2-3 камеры Sony",
      "Аудиооборудование и микрофоны гостям",
      "Профессиональный световой сетап",
      "Оператор-инженер на площадке",
      "Предварительная настройка сцены"
    ],
    popular: true
  },
  {
    title: "Пакет «Под Ключ»",
    price: "от 15 000 ₽",
    period: "за проект",
    desc: "Полный цикл от записи до публикации готового выпуска на всех площадках.",
    features: [
      "Запись аудио и видео (до 2 часов)",
      "Монтаж выпуска (вырезка пауз, дублей)",
      "Цветокоррекция и сведение звука",
      "Создание заставок / саунд-дизайн",
      "Дистрибуция на Apple, Яндекс и YouTube"
    ],
    popular: false
  }
];
---

<section class="relative py-[clamp(5rem,9vw,9rem)] bg-bg-darkest border-t border-border z-10" id="packages">
  <!-- Glow -->
  <div class="absolute -top-20 left-1/3 w-64 h-64 bg-glow-cyan rounded-full blur-3xl animate-glow-pulse pointer-events-none"></div>

  <div class="w-full max-w-[1200px] mx-auto px-8">
    <div class="mb-12 max-w-[600px]" data-reveal>
      <span class="font-mono text-[0.7rem] font-normal tracking-[0.15em] text-accent inline-flex items-center gap-2 mb-4 uppercase before:content-['//'] before:text-text-muted">Тарифы //</span>
      <h2>Стоимость услуг</h2>
      <p class="text-[1.05rem] text-text-secondary">
        Прозрачные цены без скрытых платежей. Выберите оптимальный пакет под ваши задачи.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-6 items-stretch">
      {packages.map((pkg, idx) => (
        <div 
          class:list={[
            'relative rounded bg-glass border backdrop-blur-[20px] p-8 lg:py-12 lg:px-8 flex flex-col transition-all duration-400 hover:-translate-y-1',
            pkg.popular 
              ? 'border-white/15 bg-[radial-gradient(circle_at_top_right,rgba(200,162,123,0.06)_0%,rgba(13,12,12,0.7)_100%)] shadow-[0_8px_40px_rgba(200,162,123,0.08)] hover:shadow-[0_12px_48px_rgba(200,162,123,0.12)]' 
              : 'border-border hover:border-white/15 hover:shadow-[0_8px_32px_rgba(0,0,0,0.6)]'
          ]}
          data-reveal
          data-reveal-delay={String(idx + 1)}
        >
          {pkg.popular && <span class="absolute top-4 right-4 bg-white text-[#070606] font-mono text-[0.6rem] font-bold uppercase px-2.5 py-1 rounded-sm tracking-[0.05em] shadow-[0_0_16px_rgba(255,255,255,0.1)]">Популярно</span>}
          <div class="border-b border-border pb-6 mb-6">
            <h3 class="font-display text-xl font-bold mb-3 uppercase tracking-[-0.01em]">{pkg.title}</h3>
            <div class="flex items-baseline mb-3">
              <span class="font-display text-[2rem] font-extrabold text-text-primary tracking-[-0.02em]">{pkg.price}</span>
              <span class="font-mono text-[0.8rem] text-text-secondary">/{pkg.period}</span>
            </div>
            <p class="text-sm leading-relaxed text-text-secondary">{pkg.desc}</p>
          </div>
          
          <ul class="list-none flex flex-col gap-3 mb-12 grow">
            {pkg.features.map(feat => (
              <li class="flex items-start gap-3 text-[0.9rem] text-text-secondary leading-snug">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent shrink-0 mt-0.5"><polyline points="20 6 9 17 4 12" /></svg>
                <span>{feat}</span>
              </li>
            ))}
          </ul>

          <a href="#contact" class:list={[
            'w-full inline-flex items-center justify-center px-6 py-3 font-display text-xs font-bold uppercase tracking-[0.1em] rounded-sm transition-all duration-400 cursor-pointer',
            pkg.popular 
              ? 'bg-white text-bg-darkest hover:bg-primary-hover hover:-translate-y-0.5 hover:shadow-[0_0_30px_rgba(255,255,255,0.15)]' 
              : 'border border-border text-text-primary bg-transparent hover:border-white hover:bg-white/[0.03]'
          ]}>
            Заказать расчет //
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
