---
import { getImage } from 'astro:assets';
import applePoster from '../assets/images/apple-poster.jpg';
import alcoPoster from '../assets/images/alco-poster.jpg';
import cboPoster from '../assets/images/cbo-poster.jpg';
import bandaPoster from '../assets/images/banda-poster.jpg';

const categories = ["Все", "Реклама", "Клипы", "Трансляции", "Кино", "Анимация"];

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const projectsRaw = [
  {
    title: "Рекламный ролик Золотое Яблоко",
    category: "Реклама",
    desc: "Динамичный и эстетичный рекламный ролик для сети парфюмерии и косметики. Профессиональный монтаж, работа со светом и цветом.",
    videoUrl: "https://kinescope.io/embed/b2cDjUfESLQUpa3LLbZ5LZ",
    image: applePoster
  },
  {
    title: "Промо-ролик ALCO",
    category: "Реклама",
    desc: "Стильный и атмосферный промо-ролик с глубокой игрой теней, выверенной композицией кадров и премиальным качеством съемки.",
    videoUrl: "https://kinescope.io/embed/bP76PynKdWHrdwDZbjthUZ",
    image: alcoPoster
  },
  {
    title: "Имиджевый ролик ЦБО",
    category: "Кино",
    desc: "Имиджевый фильм для Центра бизнес-образования. Интервью, репортажная съемка, динамичные переходы и компиляция лучших кадров.",
    videoUrl: "https://kinescope.io/embed/qHKGrDaBEmQaQTjgi1iSkp",
    image: cboPoster
  },
  {
    title: "Музыкальный клип Моя Банда",
    category: "Клипы",
    desc: "Атмосферный музыкальный клип. Креативная режиссура, неоновые локации, сюжетные линии и глубокая художественная цветокоррекция.",
    videoUrl: "https://kinescope.io/embed/7QcNKLymh9WcaB3Li3fqrR",
    image: bandaPoster
  }
];

const projects = await Promise.all(
  projectsRaw.map(async (project) => {
    const optimized = await getImage({ src: project.image, format: 'webp', width: 600, quality: 80 });
    return {
      ...project,
      thumbnailSrc: optimized.src
    };
  })
);
---

<section class="section portfolio-section" id="portfolio">
  <div class="container">
    <div class="portfolio-header">
      <div class="header-left">
        <span class="eyebrow">Портфолио //</span>
        <h2>Наши работы</h2>
      </div>
      
      <!-- Category Filter Tabs -->
      <div class="filter-tabs" role="tablist" aria-label="Фильтр проектов">
        {categories.map((cat, idx) => (
          <button 
            class:list={['filter-btn', { active: idx === 0 }]} 
            role="tab" 
            aria-selected={idx === 0 ? "true" : "false"}
            data-filter={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Portfolio Grid -->
    <div class="projects-grid" id="projects-grid">
      {projects.map(project => (
        <div class="project-card glass" data-category={project.category} data-video-src={project.videoUrl}>
          <div class="project-poster">
            <span class="film-border top-border"></span>
            <span class="film-border bottom-border"></span>
            <div class="poster-overlay">
              <div class="play-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3" /></svg>
              </div>
            </div>
            <img 
              src={project.thumbnailSrc} 
              loading="lazy"
              decoding="async"
              alt={project.title}
              class="poster-image-bg"
            />
          </div>
          <div class="project-info">
            <span class="project-cat">{project.category}</span>
            <h3 class="project-title">{project.title}</h3>
            <p class="project-desc">{project.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const filterVal = btn.getAttribute('data-filter');

      projectCards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        
        if (filterVal === 'Все' || cardCat === filterVal) {
          card.classList.remove('hide');
        } else {
          card.classList.add('hide');
        }
      });
    });
  });
</script>

<style>
  .portfolio-section {
    background-color: var(--color-bg-darkest);
    border-top: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .portfolio-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-bottom: var(--space-xxl);
  }

  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-secondary);
    padding: 0.4rem 1.0rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-btn.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #070606;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  .project-card {
    border-radius: var(--border-radius-md);
    overflow: hidden;
    cursor: pointer;
    transition: all var(--transition-normal);
    display: flex;
    flex-direction: column;
  }

  .project-card.hide {
    display: none;
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .project-poster {
    width: 100%;
    aspect-ratio: 16 / 9;
    position: relative;
    background-color: #0d0c0c;
    overflow: hidden;
  }

  .film-border {
    position: absolute;
    left: 0;
    width: 100%;
    height: 6px;
    background-image: radial-gradient(circle, rgba(224, 150, 92, 0.15) 1px, transparent 2px);
    background-size: 12px 100%;
    z-index: 5;
  }

  .top-border { top: 2px; }
  .bottom-border { bottom: 2px; }

  .poster-image-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all var(--transition-normal);
  }

  .project-card:hover .poster-image-bg {
    transform: scale(1.03);
    opacity: 0.9;
  }

  .poster-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 2;
    background-color: rgba(7, 6, 6, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .project-card:hover .poster-overlay {
    opacity: 1;
  }

  .play-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: #070606;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: scale(0.8);
    transition: all var(--transition-normal);
  }

  .play-btn svg {
    transform: translateX(1px);
  }

  .project-card:hover .play-btn {
    transform: scale(1);
  }

  .project-info {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-cat {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 500;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xs);
  }

  .project-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .project-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* Media Queries */
  @media (min-width: 768px) {
    .portfolio-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
    
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
    }
  }
</style>
