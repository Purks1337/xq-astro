---
const categories = ["Все", "Реклама", "Клипы", "Трансляции", "Кино", "Анимация"];

const projects = [
  {
    title: "Фирменная Реклама бренда X",
    category: "Реклама",
    desc: "Продвижение технологической платформы. Сочетание реальных съемок и 3D-графики.",
    videoUrl: "https://kinescope.io/embed/placeholder-ad",
    thumbnail: "rgba(224, 150, 92, 0.02)"
  },
  {
    title: "Музыкальный клип артиста Y",
    category: "Клипы",
    desc: "Атмосферный клип в стиле нео-нуар с акцентом на цветовую палибру.",
    videoUrl: "https://kinescope.io/embed/placeholder-clip",
    thumbnail: "rgba(224, 150, 92, 0.02)"
  },
  {
    title: "Онлайн Трансляция События",
    category: "Трансляции",
    desc: "Многокамерная прямая трансляция финала соревнований с выводом статистики.",
    videoUrl: "https://kinescope.io/embed/placeholder-stream",
    thumbnail: "rgba(224, 150, 92, 0.02)"
  },
  {
    title: "Документальный проект «Урал»",
    category: "Кино",
    desc: "История людей искусства на Урале. Полный цикл производства.",
    videoUrl: "https://kinescope.io/embed/placeholder-doc",
    thumbnail: "rgba(224, 150, 92, 0.02)"
  },
  {
    title: "Промо-ролик для стартапа",
    category: "Реклама",
    desc: "Динамичный видеоролик, объясняющий принципы работы приложения за 60 секунд.",
    videoUrl: "https://kinescope.io/embed/placeholder-promo",
    thumbnail: "rgba(224, 150, 92, 0.02)"
  },
  {
    title: "3D Презентация Девайса",
    category: "Анимация",
    desc: "Реалистичный рендер и симуляция физики для технологического продукта.",
    videoUrl: "https://kinescope.io/embed/placeholder-animation",
    thumbnail: "rgba(224, 150, 92, 0.02)"
  }
];
---

<section class="relative py-[clamp(5rem,9vw,9rem)] bg-bg-darkest border-t border-border overflow-hidden z-10" id="portfolio">
  <!-- Glow decoration -->
  <div class="absolute top-1/3 -right-40 w-72 h-72 bg-glow-amber rounded-full blur-3xl animate-glow-pulse pointer-events-none"></div>

  <div class="w-full max-w-[1200px] mx-auto px-8">
    <div class="flex flex-col md:flex-row md:justify-between md:items-end gap-6 mb-12" data-reveal>
      <div>
        <span class="font-mono text-[0.7rem] font-normal tracking-[0.15em] text-accent inline-flex items-center gap-2 mb-4 uppercase before:content-['//'] before:text-text-muted">Портфолио //</span>
        <h2>Наши работы</h2>
      </div>
      
      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Фильтр проектов">
        {categories.map((cat, idx) => (
          <button 
            class:list={[
              'filter-btn bg-transparent border border-border rounded-sm text-text-secondary px-4 py-1.5 font-mono text-[0.7rem] font-medium tracking-[0.08em] uppercase cursor-pointer transition-all duration-200 hover:border-white hover:text-white hover:shadow-[0_0_12px_rgba(255,255,255,0.06)]',
              { 'active !bg-white !border-white !text-[#070606] !shadow-[0_0_20px_rgba(255,255,255,0.1)]': idx === 0 }
            ]} 
            role="tab" 
            aria-selected={idx === 0 ? "true" : "false"}
            data-filter={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Portfolio Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-6" id="projects-grid">
      {projects.map((project, idx) => (
        <div 
          class="project-card rounded bg-glass border border-border backdrop-blur-[20px] overflow-hidden cursor-pointer transition-all duration-400 flex flex-col hover:-translate-y-1 hover:border-white/15 hover:shadow-[0_8px_32px_rgba(0,0,0,0.6),0_0_20px_rgba(200,162,123,0.05)]" 
          data-category={project.category} 
          data-video-src={project.videoUrl}
          data-reveal
          data-reveal-delay={String(Math.min(idx + 1, 6))}
        >
          <div class="w-full aspect-video relative bg-[#0d0c0c] overflow-hidden group">
            <span class="absolute top-0.5 left-0 w-full h-1.5 bg-[radial-gradient(circle,rgba(224,150,92,0.15)_1px,transparent_2px)] bg-[size:12px_100%] z-5"></span>
            <span class="absolute bottom-0.5 left-0 w-full h-1.5 bg-[radial-gradient(circle,rgba(224,150,92,0.15)_1px,transparent_2px)] bg-[size:12px_100%] z-5"></span>
            <div class="absolute inset-0 z-2 bg-[rgba(7,6,6,0.5)] flex items-center justify-center opacity-0 transition-opacity duration-400 group-hover:opacity-100">
              <div class="w-12 h-12 rounded-full bg-white text-[#070606] flex items-center justify-center scale-75 transition-all duration-400 group-hover:scale-100 shadow-[0_0_24px_rgba(255,255,255,0.2)]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="translate-x-px"><polygon points="5 3 19 12 5 21 5 3" /></svg>
              </div>
            </div>
            <div class="w-full h-full bg-[linear-gradient(rgba(224,150,92,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(224,150,92,0.02)_1px,transparent_1px)] bg-[size:20px_20px] transition-all duration-400 group-hover:scale-[1.03] group-hover:opacity-90" style={`background-color: ${project.thumbnail}`}></div>
          </div>
          <div class="p-6 flex flex-col grow">
            <span class="font-mono text-[0.65rem] uppercase text-white font-medium tracking-[0.1em] mb-2">{project.category}</span>
            <h3 class="font-display text-[1.1rem] font-bold mb-2 leading-tight uppercase tracking-[-0.01em]">{project.title}</h3>
            <p class="text-sm leading-relaxed text-text-secondary">{project.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active', '!bg-white', '!border-white', '!text-[#070606]', '!shadow-[0_0_20px_rgba(255,255,255,0.1)]');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active', '!bg-white', '!border-white', '!text-[#070606]', '!shadow-[0_0_20px_rgba(255,255,255,0.1)]');
      btn.setAttribute('aria-selected', 'true');

      const filterVal = btn.getAttribute('data-filter');

      projectCards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        
        if (filterVal === 'Все' || cardCat === filterVal) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
