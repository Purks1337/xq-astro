---
const team = [
  {
    name: "Марк",
    role: "CEO",
    desc: "10 лет опыта в ТВ, кино и рекламе. Механик камеры, DIT.",
    initials: "M"
  },
  {
    name: "Олег",
    role: "CCO / Design",
    desc: "Более 11 лет опыта в дизайне, WEB, UX/UI. Собираю интерфейсы.",
    initials: "O"
  },
  {
    name: "Николай",
    role: "SMM",
    desc: "Более 7 лет работы с крупными блогерами, маркетинг, SMM.",
    initials: "N"
  },
  {
    name: "Сергей",
    role: "Звукорежиссер",
    desc: "20 лет опыта. Запись, сведение, мастеринг. Кино, музыка.",
    initials: "S"
  },
  {
    name: "Валерий",
    role: "CCO / Commercial",
    desc: "Коммерческий директор. Продажи и коммуникация с ключевыми партнерами.",
    initials: "V"
  },
  {
    name: "Андрей",
    role: "SDR / Продажи",
    desc: "Деловые переговоры и первичная коммуникация с клиентами.",
    initials: "A"
  },
  {
    name: "Святослав",
    role: "Менеджер проектов",
    desc: "Организация съемочного процесса, контроль соблюдения сроков и бюджета.",
    initials: "S"
  },
  {
    name: "Илья",
    role: "Монтаж / Графика",
    desc: "Реклама, видеоблоги, соцсети. Видеомонтаж и цветокоррекция.",
    initials: "I"
  }
];
---

<section class="relative py-[clamp(5rem,9vw,9rem)] bg-bg-darkest border-t border-border overflow-hidden z-10" id="team">
  <!-- Glow decoration -->
  <div class="absolute -bottom-32 left-1/4 w-80 h-80 bg-glow-violet rounded-full blur-3xl animate-float-slow pointer-events-none"></div>

  <div class="w-full max-w-[1200px] mx-auto px-8">
    <div class="mb-12 max-w-[600px]" data-reveal>
      <span class="font-mono text-[0.7rem] font-normal tracking-[0.15em] text-accent inline-flex items-center gap-2 mb-4 uppercase before:content-['//'] before:text-text-muted">Команда //</span>
      <h2>Наша команда</h2>
      <p class="text-[1.05rem] leading-relaxed text-text-secondary">
        Сплоченный коллектив профессионалов с опытом работы в кино, ТВ и интернет-медиа от 5 до 20 лет.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 xl:gap-6">
      {team.map((member, idx) => (
        <div 
          class="rounded bg-glass border border-border backdrop-blur-[20px] p-8 flex flex-row xl:flex-col items-center xl:items-start gap-6 transition-all duration-400 hover:-translate-y-1 hover:border-white/15 hover:shadow-[0_8px_32px_rgba(0,0,0,0.6),0_0_16px_rgba(200,162,123,0.06)] group"
          data-reveal
          data-reveal-delay={String(Math.min(idx + 1, 8))}
        >
          <div class="w-[60px] h-[60px] xl:w-16 xl:h-16 rounded-full bg-[rgba(224,150,92,0.03)] border border-border flex items-center justify-center shrink-0 font-display text-xl xl:text-2xl font-bold text-white transition-all duration-400 group-hover:border-accent group-hover:bg-[rgba(224,150,92,0.08)] group-hover:shadow-[0_0_20px_rgba(200,162,123,0.15)]">
            {member.initials}
          </div>
          <div class="flex flex-col">
            <span class="font-mono text-[0.65rem] uppercase text-accent font-medium tracking-[0.1em] mb-0.5">{member.role}</span>
            <h3 class="font-display text-[1.15rem] font-bold mb-2 leading-tight uppercase tracking-[-0.01em]">{member.name}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{member.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
