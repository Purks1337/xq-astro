---
const team = [
  {
    name: "Марк",
    role: "CEO",
    desc: "10 лет опыта в ТВ, кино и рекламе. Механик камеры, DIT.",
    initials: "M"
  },
  {
    name: "Олег",
    role: "CCO / Design",
    desc: "Более 11 лет опыта в дизайне, WEB, UX/UI. Собираю интерфейсы.",
    initials: "O"
  },
  {
    name: "Николай",
    role: "SMM",
    desc: "Более 7 лет работы с крупными блогерами, маркетинг, SMM.",
    initials: "N"
  },
  {
    name: "Сергей",
    role: "Звукорежиссер",
    desc: "20 лет опыта. Запись, сведение, мастеринг. Кино, музыка.",
    initials: "S"
  },
  {
    name: "Святослав",
    role: "Менеджер проектов",
    desc: "Организация съемочного процесса, контроль соблюдения сроков и бюджета.",
    initials: "S"
  },
  {
    name: "Илья",
    role: "Монтаж / Графика",
    desc: "Реклама, видеоблоги, соцсети. Видеомонтаж и цветокоррекция.",
    initials: "I"
  }
];
---

<section class="section team-section" id="team">
  <div class="container">
    <div class="team-header">
      <span class="eyebrow">Команда //</span>
      <h2>Наша команда</h2>
      <p class="team-subtitle">
        Сплоченный коллектив профессионалов с опытом работы в кино, ТВ и интернет-медиа от 5 до 20 лет.
      </p>
    </div>

    <div class="team-grid">
      {team.map(member => (
        <div class="team-card glass">
          <div class="member-avatar">
            <span class="avatar-initials">{member.initials}</span>
          </div>
          <div class="member-info">
            <span class="member-role">{member.role}</span>
            <h3 class="member-name">{member.name}</h3>
            <p class="member-desc">{member.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .team-section {
    background-color: var(--color-bg-darkest);
    border-top: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .team-header {
    margin-bottom: var(--space-xxl);
    max-width: 600px;
  }

  .team-subtitle {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .team-grid {
    display: flex;
    overflow-x: auto;
    gap: var(--space-lg);
    scroll-behavior: smooth;
    padding-bottom: var(--space-lg);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(224, 150, 92, 0.3) transparent;
  }

  .team-grid::-webkit-scrollbar {
    height: 6px;
  }

  .team-grid::-webkit-scrollbar-track {
    background: transparent;
  }

  .team-grid::-webkit-scrollbar-thumb {
    background-color: rgba(224, 150, 92, 0.2);
    border-radius: var(--border-radius-sm);
  }

  .team-grid::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-primary);
  }

  .team-card {
    flex: 0 0 280px;
    border-radius: var(--border-radius-md);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    transition: all var(--transition-normal);
  }

  .team-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }

  .member-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: rgba(224, 150, 92, 0.03);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-primary);
    transition: all var(--transition-normal);
  }

  .team-card:hover .member-avatar {
    border-color: var(--color-primary);
    background-color: rgba(224, 150, 92, 0.08);
    box-shadow: 0 0 15px rgba(224, 150, 92, 0.1);
  }

  .member-info {
    display: flex;
    flex-direction: column;
  }

  .member-role {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 500;
    letter-spacing: 0.1em;
    margin-bottom: 2px;
  }

  .member-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .member-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>
