---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingPackages from '../components/PricingPackages.astro';
import Equipment from '../components/Equipment.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import VideoModal from '../components/VideoModal.astro';
---

<BaseLayout 
  title="Аренда студии подкастов в Екатеринбурге (ЕКБ): Запись видеоподкастов | Хвалите Quality"
  description="Снимайте подкасты в лучшем качестве и уютной атмосфере. Аренда видеостудии в ЕКБ. Современное аудио и видео оборудование, локация-трансформер, хромакей."
>
  <!-- Podcast Hero -->
  <section class="relative min-h-[90vh] flex items-center justify-center pt-[120px] pb-12 overflow-hidden">
    <!-- Glow blobs -->
    <div class="absolute -top-24 right-1/4 w-[24rem] h-[24rem] bg-glow-amber rounded-full blur-3xl animate-glow-pulse pointer-events-none"></div>
    <div class="absolute bottom-20 -left-32 w-64 h-64 bg-glow-violet rounded-full blur-3xl animate-float pointer-events-none"></div>

    <div class="w-full max-w-[1200px] mx-auto px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="flex flex-col z-10" data-reveal>
        <span class="font-mono text-[0.7rem] font-normal tracking-[0.15em] text-accent inline-flex items-center gap-2 mb-4 uppercase before:content-['//'] before:text-text-muted">Студия подкастов</span>
        <h1>Снимайте подкасты в лучшем качестве</h1>
        <p class="text-[clamp(1.1rem,2vw,1.3rem)] leading-relaxed mt-6 mb-12 max-w-[550px]">
          Уютное пространство-трансформер в Екатеринбурге. Световые сетапы под любой стиль, ретро-телевизоры, гринскрин и премиальный звук Shure SM7B. Запись аудио и видео «под ключ».
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#contact" class="inline-flex items-center justify-center px-8 py-3.5 font-display text-sm font-bold uppercase tracking-[0.1em] rounded-sm bg-white text-bg-darkest transition-all duration-400 hover:bg-primary-hover hover:-translate-y-0.5 hover:shadow-[0_0_30px_rgba(255,255,255,0.15)]">Забронировать дату</a>
          <a href="tel:+79923410520" class="inline-flex items-center justify-center px-8 py-3.5 font-display text-sm font-bold uppercase tracking-[0.1em] rounded-sm border border-border text-text-primary bg-transparent transition-all duration-400 hover:border-white hover:bg-white/[0.03]">Позвонить</a>
        </div>
      </div>

      <div class="w-full flex justify-center z-10" data-reveal data-reveal-delay="2">
        <div class="relative w-full max-w-[600px] aspect-video border border-white/[0.04] p-4 bg-white/[0.01]">
          <span class="absolute top-1 left-1 w-4 h-4 border-l-[1.5px] border-t-[1.5px] border-white/30"></span>
          <span class="absolute top-1 right-1 w-4 h-4 border-r-[1.5px] border-t-[1.5px] border-white/30"></span>
          <span class="absolute bottom-1 left-1 w-4 h-4 border-l-[1.5px] border-b-[1.5px] border-white/30"></span>
          <span class="absolute bottom-1 right-1 w-4 h-4 border-r-[1.5px] border-b-[1.5px] border-white/30"></span>
          
          <span class="absolute top-3.5 left-3.5 w-2 h-2 bg-white rounded-full animate-glow-pulse"></span>
          <span class="absolute top-2.5 left-7 font-display text-[0.65rem] font-bold text-text-primary tracking-[0.1em]">ЭФИР</span>
          
          <div class="w-full h-full rounded-sm overflow-hidden relative bg-[#101012]">
            <div class="w-full h-full bg-[linear-gradient(rgba(255,107,0,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(255,107,0,0.04)_1px,transparent_1px)] bg-[size:20px_20px] opacity-60"></div>
            <div class="absolute bottom-6 left-6 z-2 flex flex-col gap-1">
              <span class="self-start bg-[rgba(255,107,0,0.1)] text-white border border-white px-2 py-0.5 text-xs font-display rounded uppercase font-semibold tracking-[0.05em]">Екатеринбург, Ботаническая 19</span>
              <h3 class="text-xl m-0">Ламповая атмосфера 24/7</h3>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Space Locations / Features -->
  <section class="relative py-[clamp(5rem,9vw,9rem)] bg-bg-darkest border-t border-border z-10" id="space">
    <div class="w-full max-w-[1200px] mx-auto px-8">
      <div class="mb-12 max-w-[600px]" data-reveal>
        <span class="font-mono text-[0.7rem] font-normal tracking-[0.15em] text-accent inline-flex items-center gap-2 mb-4 uppercase before:content-['//'] before:text-text-muted">Локации</span>
        <h2>Уютные интерьеры для ваших съемок</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="rounded-md bg-glass border border-border backdrop-blur-[20px] overflow-hidden flex flex-col transition-all duration-400 hover:border-white/15 hover:-translate-y-1 hover:shadow-[0_8px_32px_rgba(0,0,0,0.6),0_0_16px_rgba(200,162,123,0.06)]" data-reveal data-reveal-delay="1">
          <div class="w-full aspect-[16/10] bg-[#101012] bg-[linear-gradient(135deg,rgba(255,107,0,0.03)_25%,transparent_25%),linear-gradient(225deg,rgba(255,107,0,0.03)_25%,transparent_25%)] bg-[size:30px_30px]"></div>
          <div class="p-6">
            <h3 class="text-xl mb-2">Локация Трансформер</h3>
            <p class="text-[0.95rem] leading-relaxed text-text-secondary">
              Более 20 вариантов фоновых решений. Мы быстро соберем сцену под ваш формат: от классических текстурных фонов и кирпичной кладки до цифровых миров через встроенный хромакей (гринскрин).
            </p>
          </div>
        </div>

        <div class="rounded-md bg-glass border border-border backdrop-blur-[20px] overflow-hidden flex flex-col transition-all duration-400 hover:border-white/15 hover:-translate-y-1 hover:shadow-[0_8px_32px_rgba(0,0,0,0.6),0_0_16px_rgba(200,162,123,0.06)]" data-reveal data-reveal-delay="2">
          <div class="w-full aspect-[16/10] bg-[#101012] bg-[radial-gradient(rgba(255,107,0,0.02)_20%,transparent_20%),radial-gradient(rgba(255,107,0,0.02)_20%,transparent_20%)] bg-[size:20px_20px] bg-[position:0_0,10px_10px]"></div>
          <div class="p-6">
            <h3 class="text-xl mb-2">Лаундж Локация</h3>
            <p class="text-[0.95rem] leading-relaxed text-text-secondary">
              Антуражная сцена, окруженная зелеными растениями. Главная фишка — инсталляция из 5 ретро-телевизоров, на экраны которых можно вывести любой ваш логотип, статичное изображение или видеоряд.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Podcast Packages -->
  <PricingPackages />

  <!-- Equipment Specification Tabs -->
  <Equipment />

  <!-- FAQ Accordion -->
  <FAQ />

  <!-- Contact Form Section -->
  <ContactForm 
    title="Забронировать студию" 
    subtitle="Оставьте ваши контакты. Мы перезвоним вам в течение часа, чтобы подтвердить свободное время и согласовать аренду."
  />

  <!-- Video Lightbox Player Modal -->
  <VideoModal />
</BaseLayout>
