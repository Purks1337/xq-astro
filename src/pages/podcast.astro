---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingPackages from '../components/PricingPackages.astro';
import Equipment from '../components/Equipment.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import VideoModal from '../components/VideoModal.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout 
  title="Аренда студии подкастов в Екатеринбурге (ЕКБ): Запись видеоподкастов | Хвалите Quality"
  description="Снимайте подкасты в лучшем качестве и уютной атмосфере. Аренда видеостудии в ЕКБ. Современное аудио и видео оборудование, локация-трансформер, хромакей."
>
  <!-- Podcast Hero -->
  <section class="podcast-hero">
    <div class="container hero-container">
      
      <!-- Asymmetric Offset Typography Layout -->
      <div class="hero-grid">
        <div class="hero-col-left">
          <span class="eyebrow">Студия подкастов //</span>
          <h1 class="hero-title">Снимайте подкасты в лучшем качестве</h1>
        </div>
        
        <div class="hero-col-right">
          <p class="hero-desc">
            Уютное пространство-трансформер в Екатеринбурге. Световые сетапы под любой стиль, ретро-телевизоры, гринскрин и премиальный звук Shure SM7B. Запись аудио и видео «под ключ».
          </p>
          <div class="hero-ctas">
            <a href="#contact" class="btn btn-primary">Забронировать дату</a>
            <a href="tel:+79923410520" class="btn btn-secondary">Позвонить</a>
          </div>
        </div>
      </div>

      <!-- Cinematic Monitor Viewport -->
      <div class="cinematic-viewport-wrapper">
        <div class="camera-hud">
          <span class="hud-corner top-left"></span>
          <span class="hud-corner top-right"></span>
          <span class="hud-corner bottom-left"></span>
          <span class="hud-corner bottom-right"></span>
          
          <div class="hud-bar top-bar">
            <span class="hud-rec"><span class="rec-dot"></span>ЗАПИСЬ</span>
            <span class="hud-ratio">Екатеринбург, Ботаническая 19</span>
          </div>
          
          <div class="hud-bar bottom-bar">
            <span class="hud-fps">ЛАМПОВАЯ АТМОСФЕРА 24/7</span>
            <span class="hud-tc">00:00:00:00</span>
          </div>

          <div class="viewport-content">
            <div class="poster-media" style={`background-image: url('${base}images/studio-hero.jpg')`}>
              <div class="grid-overlay"></div>
              <div class="center-target"></div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Space Locations / Features -->
  <section class="section space-section" id="space">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Локации</span>
        <h2>Уютные интерьеры для ваших съемок</h2>
      </div>

      <div class="locations-grid">
        <div class="loc-card glass">
          <div class="loc-visual location-transformer" style={`background-image: url('${base}images/studio-transformer.jpg')`}></div>
          <div class="loc-info">
            <h3>Локация Трансформер</h3>
            <p>
              Более 20 вариантов фоновых решений. Мы быстро соберем сцену под ваш формат: от классических текстурных фонов и кирпичной кладки до цифровых миров через встроенный хромакей (гринскрин).
            </p>
          </div>
        </div>

        <div class="loc-card glass">
          <div class="loc-visual location-lounge" style={`background-image: url('${base}images/studio-lounge.jpg')`}></div>
          <div class="loc-info">
            <h3>Лаундж Локация</h3>
            <p>
              Антуражная сцена, окруженная зелеными растениями. Главная фишка — инсталляция из 5 ретро-телевизоров, на экраны которых можно вывести любой ваш логотип, статичное изображение или видеоряд.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Podcast Packages -->
  <PricingPackages />

  <!-- Equipment Specification Tabs -->
  <Equipment />

  <!-- FAQ Accordion -->
  <FAQ />

  <!-- Contact Form Section -->
  <ContactForm 
    title="Забронировать студию" 
    subtitle="Оставьте ваши контакты. Мы перезвоним вам в течение часа, чтобы подтвердить свободное время и согласовать аренду."
  />

  <!-- Video Lightbox Player Modal -->
  <VideoModal />
</BaseLayout>

<style>
  .podcast-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 150px;
    padding-bottom: var(--space-xxl);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxl);
  }

  /* Asymmetric Offset Grid */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: flex-start;
    text-align: left;
    z-index: 10;
  }

  .hero-col-left {
    display: flex;
    flex-direction: column;
  }

  .hero-title {
    font-size: clamp(2.6rem, 7vw, 5.2rem);
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  .hero-col-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    justify-content: flex-end;
  }

  .hero-desc {
    font-size: clamp(1.0rem, 1.4vw, 1.15rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 540px;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-md);
  }

  .hero-ctas .btn {
    padding: 0.8rem 1.6rem;
    font-size: 0.78rem;
  }

  /* Cinematic Monitor Viewport */
  .cinematic-viewport-wrapper {
    width: 100%;
    z-index: 10;
    margin-top: var(--space-md);
  }

  .camera-hud {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 9;
    border: 1px solid var(--color-border);
    padding: 24px;
    background-color: rgba(12, 14, 18, 0.4);
    box-shadow: var(--shadow-md);
  }

  .hud-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: rgba(255, 255, 255, 0.2);
    border-style: solid;
    transition: all var(--transition-normal);
  }

  .camera-hud:hover .hud-corner {
    border-color: var(--color-primary);
    width: 18px;
    height: 18px;
  }

  .top-left { top: 6px; left: 6px; border-width: 1px 0 0 1px; }
  .top-right { top: 6px; right: 6px; border-width: 1px 1px 0 0; }
  .bottom-left { bottom: 6px; left: 6px; border-width: 0 0 1px 1px; }
  .bottom-right { bottom: 6px; right: 6px; border-width: 0 1px 1px 0; }

  .hud-bar {
    position: absolute;
    width: calc(100% - 48px);
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
    z-index: 5;
  }

  .top-bar { top: 10px; }
  .bottom-bar { bottom: 10px; }

  .hud-rec {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-primary);
  }

  .rec-dot {
    width: 6px;
    height: 6px;
    background-color: #ef4444;
    border-radius: 50%;
    animation: flash 1.5s infinite;
  }

  .viewport-content {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    background-color: #07090c;
  }

  .poster-media {
    width: 100%;
    height: 100%;
    opacity: 0.6;
    background-size: cover;
    background-position: center;
    transition: all var(--transition-slow);
  }

  .grid-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 33.33% 33.33%;
  }

  .center-target {
    position: absolute;
    top: 50%; left: 50%; width: 12px; height: 12px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .center-target::before, .center-target::after {
    content: '';
    position: absolute;
    background-color: rgba(255, 255, 255, 0.15);
  }
  .center-target::before { top: 50%; left: -6px; width: 24px; height: 1px; }
  .center-target::after { left: 50%; top: -6px; width: 1px; height: 24px; }

  @keyframes flash {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  /* Locations Styles */
  .space-section {
    background-color: var(--color-bg-darkest);
    border-top: 1px solid var(--color-border);
    position: relative;
  }

  .section-heading {
    margin-bottom: var(--space-xxl);
    max-width: 600px;
  }

  .locations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  .loc-card {
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all var(--transition-normal);
  }

  .loc-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .loc-visual {
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: #101012;
    position: relative;
  }

  .location-transformer {
    background-size: cover;
    background-position: center;
  }

  .location-lounge {
    background-size: cover;
    background-position: center;
  }

  .loc-info {
    padding: var(--space-lg);
  }

  .loc-info h3 {
    font-size: 1.3rem;
    margin-bottom: var(--space-xs);
  }

  .loc-info p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Media Queries */
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.2fr 0.8fr;
      gap: var(--space-xxl);
    }
  }

  @media (min-width: 768px) {
    .locations-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .camera-hud {
      aspect-ratio: 16 / 9;
      padding: 12px;
    }
    .hud-bar {
      display: none;
    }
    .hero-ctas {
      flex-direction: column;
      width: 100%;
    }
  }
</style>
